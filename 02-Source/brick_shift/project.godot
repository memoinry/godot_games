config_version=5

[application]
config/name="Brick Shift · memory"
config/description="A complete arcade game by memory."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="memory_BrickShift"

[display]
window/size/viewport_width=960
window/size/viewport_height=640
window/size/window_width_override=960
window/size/window_height_override=640
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.03,0.05,0.09,1)
